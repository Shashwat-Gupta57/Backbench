{
  "rules": {
    ".read": "auth != null",
    "users": {
      "$uid": {
        ".write": "$uid === auth.uid",
        "role": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === 'student')"
        },
        "isSuspended": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === false)"
        }
      }
    },
    "posts": {
      ".indexOn": [
        "timestamp",
        "authorId"
      ],
      "$postId": {
        ".write": "auth != null",
        "authorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "content": {
          ".validate": "newData.val() === data.val() || data.parent().child('authorId').val() === auth.uid || (!data.exists() && newData.parent().child('authorId').val() === auth.uid)"
        },
        "isAnonymous": {
          ".validate": "newData.val() === data.val() || data.parent().child('authorId').val() === auth.uid || (!data.exists() && newData.parent().child('authorId').val() === auth.uid)"
        },
        "timestamp": {
          ".validate": "newData.val() === data.val() || !data.exists()"
        }
      }
    },
    "replies": {
      ".indexOn": [
        "timestamp"
      ],
      "_global_last_reply": {
        ".write": "auth != null"
      },
      "$postId": {
        "$replyId": {
          ".write": "auth != null",
          "authorId": {
            ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
          }
        }
      }
    },
    "polls": {
      ".indexOn": [
        "timestamp"
      ],
      "$pollId": {
        ".write": "auth != null",
        "creatorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "question": {
          ".validate": "newData.val() === data.val() || data.parent().child('creatorId').val() === auth.uid || (!data.exists() && newData.parent().child('creatorId').val() === auth.uid)"
        },
        "options": {
          ".validate": "newData.val() === data.val() || data.parent().child('creatorId').val() === auth.uid || (!data.exists() && newData.parent().child('creatorId').val() === auth.uid)"
        },
        "timestamp": {
          ".validate": "newData.val() === data.val() || !data.exists()"
        }
      }
    },
    "petitions": {
      ".indexOn": [
        "timestamp"
      ],
      "$petitionId": {
        ".write": "auth != null",
        "creatorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        },
        "title": {
          ".validate": "newData.val() === data.val() || data.parent().child('creatorId').val() === auth.uid || (!data.exists() && newData.parent().child('creatorId').val() === auth.uid)"
        },
        "statement": {
          ".validate": "newData.val() === data.val() || data.parent().child('creatorId').val() === auth.uid || (!data.exists() && newData.parent().child('creatorId').val() === auth.uid)"
        },
        "timestamp": {
          ".validate": "newData.val() === data.val() || !data.exists()"
        }
      }
    },
    "announcements": {
      ".indexOn": [
        "timestamp"
      ],
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher'"
    },
    "notifications": {
      "$uid": {
        ".indexOn": [
          "timestamp"
        ],
        "$notifId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['senderId', 'type', 'timestamp']) && (newData.child('senderId').val() === auth.uid || $uid === auth.uid)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "saved_posts": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "saved_replies": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "postLikes": {
      ".write": "auth != null"
    },
    "postReshares": {
      ".write": "auth != null"
    },
    "replyLikes": {
      ".write": "auth != null"
    },
    "petitionVotes": {
      ".write": "auth != null"
    },
    "pollVotes": {
      ".write": "auth != null"
    },
    "pollLikes": {
      ".write": "auth != null"
    },
    "pollReshares": {
      ".write": "auth != null"
    },
    "pollReplies": {
      ".write": "auth != null"
    },
    "savedPosts": {
      ".write": "auth != null"
    },
    "savedReplies": {
      ".write": "auth != null"
    },
    "events": {
      ".write": "auth != null"
    },
    "postReports": {
      ".write": "auth != null"
    },
    "replyReports": {
      ".write": "auth != null"
    },
    "userReports": {
      ".write": "auth != null"
    }
  }
}