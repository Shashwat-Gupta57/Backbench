{
  "rules": {
    ".read": "auth != null",
    "users": {
      "$uid": {
        ".write": "$uid === auth.uid",
        "role": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === 'student')"
        },
        "isSuspended": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === false)"
        }
      }
    },
    "posts": {
      ".indexOn": ["timestamp"],
      "$postId": {
        ".write": "auth != null",
        "authorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        }
      }
    },
    "replies": {
      ".indexOn": ["timestamp"],
      "_global_last_reply": {
        ".write": "auth != null"
      },
      "$postId": {
        "$replyId": {
          ".write": "auth != null",
          "authorId": {
            ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
          }
        }
      }
    },
    "polls": {
      ".indexOn": ["timestamp"],
      "$pollId": {
        ".write": "auth != null",
        "creatorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        }
      }
    },
    "petitions": {
      ".indexOn": ["timestamp"],
      "$petitionId": {
        ".write": "auth != null",
        "creatorId": {
          ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)"
        }
      }
    },
    "announcements": {
      ".indexOn": ["timestamp"],
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'teacher'"
    },
    "notifications": {
      "$uid": {
        ".indexOn": ["timestamp"],
        ".write": "auth != null" 
      }
    },
    "friends": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "saved_posts": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    },
    "saved_replies": {
      "$uid": {
        ".write": "$uid === auth.uid"
      }
    }
  }
}
